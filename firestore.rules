// ════════════════════════════════════════════════════════════
//  RÈGLES DE SÉCURITÉ FIRESTORE — JSP Manager (base-jsp-pacy)
// ════════════════════════════════════════════════════════════
// Ce dépôt n'héberge que le frontend statique (GitHub Pages / Netlify) :
// Firestore ne lit jamais ce fichier automatiquement. Pour l'appliquer :
//   1. Firebase Console → Firestore Database → Règles → coller ce contenu → Publier
//   2. OU, avec Firebase CLI installé côté projet Firebase :
//      firebase deploy --only firestore:rules
//
// Modèle de données réel (déduit de index.html) :
//   sections/{sectionId}             → 1 doc géant par section (jsps, seances,
//                                       sports, concours, notesman, seqPlanif,
//                                       ..., updatedBy)
//   sections/{sectionId}/presences/{seanceId} → présences d'une séance, isolées
//                                       du doc géant : { presents: [id,...],
//                                       updatedAt, updatedBy }
//   users/{email}                    → email brut de l'utilisateur en clé de doc
//                                       { email, nom, role: pending|chef|formateur|aide,
//                                         createdAt, fcmTokens[] }
//   historique/{id}                  → journal d'actions, append-only
//
// Le rôle "aide" ne peut écrire QUE dans sections/{id}/presences/{seanceId}
// (et seulement les champs presents/updatedAt/updatedBy) : il reste en
// lecture seule sur le reste du document de section (JSP, séances, notes...).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myEmail()));
    }

    function myRole() {
      return exists(/databases/$(database)/documents/users/$(myEmail()))
        ? myUserDoc().data.role
        : null;
    }

    function isApprovedMember() {
      return isSignedIn() && myRole() in ['chef', 'formateur', 'aide'];
    }

    function isChef() {
      return isSignedIn() && myRole() == 'chef';
    }

    function canEditSection() {
      // 'aide' reste volontairement en dehors de cette liste (voir note en tête de fichier)
      return isSignedIn() && myRole() in ['chef', 'formateur'];
    }

    // ── sections/{sectionId} : données de la section (JSP, séances, ...) ──
    match /sections/{sectionId} {
      allow read: if isApprovedMember();
      allow write: if canEditSection();

      // ── presences/{seanceId} : présences d'une séance, isolées du doc
      // géant pour que "aide" puisse y écrire sans toucher au reste.
      match /presences/{seanceId} {
        allow read: if isApprovedMember();
        allow create: if isApprovedMember()
          && request.resource.data.keys().hasOnly(['presents', 'updatedAt', 'updatedBy']);
        allow update: if isApprovedMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presents', 'updatedAt', 'updatedBy']);
        allow delete: if canEditSection();
      }
    }

    // ── users/{email} : comptes + rôles ─────────────────────────────────
    match /users/{userId} {
      // Chacun lit son propre profil ; le chef peut lister/lire tous les comptes
      // (nécessaire pour l'écran "Gestion des accès").
      allow get:  if isSignedIn() && (myEmail() == userId || isChef());
      allow list: if isChef();

      // Un utilisateur ne peut créer que SON PROPRE document, et seulement :
      //  - avec le rôle 'pending' (compte en attente de validation), ou
      //  - avec le rôle 'chef' si aucune section n'existe encore
      //    (bootstrap : le tout premier utilisateur devient chef).
      allow create: if isSignedIn() && myEmail() == userId && (
        request.resource.data.role == 'pending' ||
        (
          request.resource.data.role == 'chef' &&
          !exists(/databases/$(database)/documents/sections/pacy)
        )
      );

      // Le chef peut changer le rôle de n'importe qui.
      // Un utilisateur peut mettre à jour SON PROPRE doc uniquement pour
      // enregistrer son token de notification (fcmTokens), jamais son rôle.
      allow update: if isSignedIn() && (
        isChef() ||
        (
          myEmail() == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        )
      );

      allow delete: if isChef();
    }

    // ── historique/{id} : journal d'actions, append-only ────────────────
    match /historique/{entryId} {
      allow read:   if isApprovedMember();
      allow create: if isApprovedMember() && request.resource.data.email == myEmail();
      allow update, delete: if false;
    }

    // ── public_cours/{sectionId} : supports de cours en lecture libre ───
    // Miroir volontairement restreint (uniquement cours + {id,prenom,pin}
    // par JSP, jamais les données de section complètes) pour la page
    // l'onglet Cours de jsp_public.html (?tab=cours), consulté par les
    // jeunes sans compte via un code PIN. Le PIN n'est pas une vraie
    // sécurité (donnée non confidentielle) : il sert à personnaliser/
    // filtrer l'accès.
    match /public_cours/{sectionId} {
      allow read: if true;
      allow write: if canEditSection();
    }

    // ── public_planning/{sectionId} : planning en lecture libre ──────────
    // Même principe que public_cours ci-dessus, pour jsp_public.html (page
    // QR code) : seules les séances (date/thème/lieu/heure/notes, jamais les
    // présences) sont dupliquées ici, jamais le document de section complet.
    match /public_planning/{sectionId} {
      allow read: if true;
      allow write: if canEditSection();
    }

    // ── public_controles/{sectionId} : sujets/corrigés en lecture libre ──
    // Même principe : uniquement {id,date,theme,lienSujet,lienCorrige} par
    // contrôle, jamais les notes des jeunes. Le délai d'affichage (visible
    // le lendemain seulement) est appliqué côté client (jsp_public.html),
    // pas ici : ces liens ne sont pas des données confidentielles.
    match /public_controles/{sectionId} {
      allow read: if true;
      allow write: if canEditSection();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
